# ============================================================
# Student Wallet API Test Requests — VS Code REST Client
# วิธีใช้: ติดตั้ง extension "REST Client" แล้วกด "Send Request"
# เหนือแต่ละ request (### แบ่ง request หนึ่ง request)
# ============================================================

@baseUrl = http://localhost:3000/api/v1
# วาง JWT token จาก response ของข้อ 2 (ยืนยัน OTP) หรือข้อ 4 (Login) ลงในตัวแปรนี้
@authToken = <วาง-JWT-token-ที่นี่>
# วาง group id จาก response ของข้อ 10 (Create Group) ลงในตัวแปรนี้
@groupId = <วาง-group-id-ที่นี่>

############################################################
# AUTH DOMAIN
############################################################

### 1. สมัครสมาชิก — ขอ OTP (ส่งอีเมล)
# ได้ registration_token (อายุ 10 นาที) เก็บไว้ใน app memory เท่านั้น — ไม่มี row ใน DB
# OTP 6 หลัก ถูกส่งทางอีเมล (ถ้าส่งไม่สำเร็จจะ log fallback ลง console ของ server)
# คาดหวัง: 200 OK
# { "success": true, "message": "ส่งรหัส OTP ไปทางอีเมลแล้ว", "registration_token": "...", "expires_in": 600 }
# error: 400 (รูปแบบผิด) / 409 (อีเมลซ้ำ) / 429 (cooldown 60 วิ หรือ เกิน 5 ครั้ง/วัน)
POST {{baseUrl}}/auth/register/request-otp
Content-Type: application/json

{
  "name": "ทดสอบ ผู้ใช้",
  "email": "test@example.com",
  "password": "password123"
}

### 2. ยืนยันรหัส OTP (สมัครสมาชิก)
# OTP = ตัวเลข 6 หลัก จากอีเมล — ผิดครบ 5 ครั้ง → token ถูกบล็อก (429)
# คาดหวัง: 200 OK
# { "success": true, "message": "สมัครสมาชิกสำเร็จ", "token": "...", "user": { "id", "name", "email" } }
POST {{baseUrl}}/auth/register/verify-otp
Content-Type: application/json

{
  "registration_token": "<วาง-registration_token จากข้อ 1>",
  "otp": "123456"
}

### 3. ขอ OTP ใหม่ (resend — สมัครสมาชิก)
# ต้องเว้น 60 วินาทีจากครั้งก่อน (429 + retry_after ถ้าเร็วเกินไป)
# คาดหวัง: 200 OK { "success": true, "registration_token": "<token ใหม่>", "expires_in": 600 }
POST {{baseUrl}}/auth/register/resend-otp
Content-Type: application/json

{
  "registration_token": "<วาง-registration_token จากข้อ 1>"
}

### 4. เข้าสู่ระบบ
# ต้องยืนยัน OTP เรียบร้อยแล้ว (is_verified = true) ถึงจะสำเร็จ
# คาดหวัง: 200 OK
# { "success": true, "message": "เข้าสู่ระบบสำเร็จ", "token": "...", "user": { "id", "email", "name" } }
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

############################################################
# PASSWORD RESET FLOW (อีเมล) — stateless
############################################################

### 4A. ลืมรหัสผ่าน — ข้อ 1: ขอ OTP (ส่งอีเมล)
# OTP ถูกส่งทางอีเมล (ถ้าส่งไม่สำเร็จจะ log fallback ลง console)
# คาดหวัง: 200 OK { "success": true, "password_reset_token": "...", "expires_in": 600 }
# error: 404 (ไม่พบอีเมล) / 403 (บัญชียังไม่ยืนยันตัวตน) / 429
POST {{baseUrl}}/auth/reset-password/request-otp
Content-Type: application/json

{
  "email": "test@example.com"
}

### 4B. ลืมรหัสผ่าน — ข้อ 2: ยืนยัน OTP
# ได้ reset_verified_token (อายุ 4 นาที, ใช้ได้ 1 ครั้ง)
# ผิดครบ 5 ครั้ง → token ถูกบล็อก (429)
# คาดหวัง: 200 OK { "success": true, "reset_verified_token": "...", "expires_in": 240 }
POST {{baseUrl}}/auth/reset-password/verify-otp
Content-Type: application/json

{
  "password_reset_token": "<วาง-password_reset_token จากข้อ 4A>",
  "otp": "123456"
}

### 4C. ลืมรหัสผ่าน — ข้อ 3: ตั้งรหัสผ่านใหม่ (จะเด้งทุกเครื่องออก)
# สำเร็จแล้ว token เก่าทั้งหมดใช้ไม่ได้ (token_version +1) → ต้อง login ใหม่ทุกเครื่อง
# token เดิมใช้ซ้ำไม่ได้ (401)
# คาดหวัง: 200 OK { "success": true, "message": "เปลี่ยนรหัสผ่านสำเร็จ กรุณาเข้าสู่ระบบใหม่" }
POST {{baseUrl}}/auth/reset-password/confirm
Content-Type: application/json

{
  "reset_verified_token": "<วาง-reset_verified_token จากข้อ 4B>",
  "newPassword": "newsecret456"
}

### 4D. เข้าสู่ระบบใหม่หลังรีเซ็ตรหัสผ่าน
# ได้ token ใหม่ที่มี ver = token_version ใหม่ (token เก่าถูกเด้งออกแล้ว)
# คาดหวัง: 200 OK { "success": true, "token": "...", "user": { ... } }
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "newsecret456"
}

############################################################
# PERSONAL DOMAIN
############################################################

### 5. ดึงรายการธุรกรรมส่วนตัว
# Query params ไม่บังคับ: ?month=9&year=2026&type=expense&category_id=1
# เรียงตาม transaction_date (ใหม่สุดก่อน) — คาดหวัง: 200 OK
# { "success": true, "transactions": [ ... ] }
GET {{baseUrl}}/personal/transactions
Authorization: Bearer {{authToken}}

### 6. สร้างรายการธุรกรรมส่วนตัว
# รับทั้ง date หรือ transaction_date (ค่า canonical = transaction_date)
# ฟิลด์แปลกๆ ที่ frontend ส่ง (category, paymentMethod, note) จะถูก backend ตัดทิ้งไป
# คาดหวัง: 200 OK
# { "success": true, "message": "บันทึกรายการสำเร็จ", "transaction": { ... } }
POST {{baseUrl}}/personal/transactions
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "ข้าวผัดหมู",
  "type": "expense",
  "amount": 45.0,
  "merchant": "ร้านข้าวอร่อย",
  "category_id": null,
  "date": "2026-09-07T10:00:00.000Z"
}

### 7. ดึงงบประมาณส่วนตัว
# Query params ไม่บังคับ: ?month=9&year=2026 — คาดหวัง: 200 OK
# { "success": true, "budgets": [ ... ] }
GET {{baseUrl}}/personal/budgets
Authorization: Bearer {{authToken}}

### 8. สร้าง/อัปเดตงบประมาณส่วนตัว
# ถ้ามี budget เดิมของ (month, year, category_id) ซ้ำจะอัปเดต monthly_limit แทนการสร้างใหม่
# คาดหวัง: 200 OK
# { "success": true, "message": "บันทึกงบประมาณสำเร็จ", "budget": { ... } }
POST {{baseUrl}}/personal/budgets
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "monthly_limit": 10000,
  "month": 9,
  "year": 2026,
  "category_id": null
}

############################################################
# GROUP DOMAIN
############################################################

### 9. ดึงรายการกลุ่มของฉัน
# คาดหวัง: 200 OK
# { "success": true, "groups": [ ... ] }
GET {{baseUrl}}/groups/my
Authorization: Bearer {{authToken}}

### 10. สร้างกลุ่มใหม่
# category: General | Trip | Food | Event — แต่ละค่าจะตั้ง icon/สีของกลุ่มให้อัตโนมัติ
# คาดหวัง: 200 OK
# { "success": true, "message": "สร้างกลุ่มสำเร็จ", "group": { "id", "name", ... } }
POST {{baseUrl}}/groups/create
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "ทริปภูเก็ต",
  "category": "Trip"
}

### 11. ดึงสมาชิกในกลุ่ม
# ใช้ groupId จากการสร้างกลุ่ม (ข้อ 10) — คาดหวัง: 200 OK
# { "success": true, "members": [ ... ] }
GET {{baseUrl}}/groups/{{groupId}}/members
Authorization: Bearer {{authToken}}

### 12. เพิ่มสมาชิกเข้ากลุ่ม
# user_id ต้องเป็น id ของผู้ใช้ที่ลงทะเบียนในระบบแล้ว (จาก response auth)
# คาดหวัง: 200 OK
# { "success": true, "message": "เพิ่มสมาชิกสำเร็จ", "member": { "id", "group_id", "user_id", ... } }
POST {{baseUrl}}/groups/{{groupId}}/members
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "user_id": "<ใส่-user-id-ของผู้ใช้ที่นี่>"
}

### 13. ดึงธุรกรรมของกลุ่ม
# คาดหวัง: 200 OK
# { "success": true, "transactions": [ ... ] }
GET {{baseUrl}}/groups/{{groupId}}/transactions
Authorization: Bearer {{authToken}}

### 14. สร้างธุรกรรมในกลุ่ม
# paid_by = id ผู้จ่าย (default: ใช้ผู้เรียกใช้เอง) — date ใช้เป็น transaction_date
# คาดหวัง: 200 OK
# { "success": true, "message": "บันทึกรายการสำเร็จ", "transaction": { ... } }
POST {{baseUrl}}/groups/{{groupId}}/transactions
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "ค่ารถตู้",
  "type": "expense",
  "amount": 600.0,
  "merchant": "รถตู้",
  "category": "Trip",
  "paid_by": null,
  "date": "2026-09-07T08:00:00.000Z"
}

############################################################
# SHARED SERVICES
############################################################

### 15. สแกนใบเสร็จ (mock OCR — ไม่มี real OCR)
# อ่านจากชื่อไฟล์รูปแบบ "merchant__total-5.50" แล้วตอบ merchant/total กลับมา
# (ไฟล์ตัวอย่าง: tests/fixtures/starbucks__total-5.50.png →
#  merchant = "starbucks", total = 5.5)
# ไม่ต้องใช้ token (route นี้เป็น public)
# คาดหวัง: 200 OK
# { "success": true, "merchant": "starbucks", "total": 5.5, "date": "...", "parsedText": "...png" }
POST {{baseUrl}}/personal/transactions/scan-receipt
Content-Type: multipart/form-data; boundary=----testBoundary

------testBoundary
Content-Disposition: form-data; name="receipt"; filename="starbucks__total-5.50.png"
Content-Type: image/png

< ./tests/fixtures/starbucks__total-5.50.png
------testBoundary--